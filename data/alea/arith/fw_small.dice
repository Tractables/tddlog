// fw_small: written by gen_arith_dice.py from fw_small.jl, the
// Alea.jl form of experiments/dicejl/fw_small.jl of Tractables/Alea.jl, branch arithmetic,
// commit 7e9ff23517086eb4518845e50218bf18b4d9f2a5 (Apache License 2.0).
// Cao, Garg, Holtzen, Van den Broeck, Millstein (UAI 2023), Table 1: floydwarshall-small.
//
// The integers are 5 bits, and 14 is the distance of no edge. Each
// edge is a uniform weight e<i>_<j>, and Floyd and Warshall's
// updates are written out in the original's order, k, i and j from 1
// to 3: d<k>_<i>_<j> is the distance from i to j after the update.
let e1_2 = uniform(5, 1, 3) in
let e1_3 = uniform(5, 3, 5) in
let e2_3 = uniform(5, 2, 4) in
let d1_1_1 = if int(5, 0) > int(5, 0) + int(5, 0) then int(5, 0) + int(5, 0) else int(5, 0) in
let d1_1_2 = if e1_2 > d1_1_1 + e1_2 then d1_1_1 + e1_2 else e1_2 in
let d1_1_3 = if e1_3 > d1_1_1 + e1_3 then d1_1_1 + e1_3 else e1_3 in
let d1_2_1 = if e1_2 > e1_2 + d1_1_1 then e1_2 + d1_1_1 else e1_2 in
let d1_2_2 = if int(5, 0) > d1_2_1 + d1_1_2 then d1_2_1 + d1_1_2 else int(5, 0) in
let d1_2_3 = if e2_3 > d1_2_1 + d1_1_3 then d1_2_1 + d1_1_3 else e2_3 in
let d1_3_1 = if e1_3 > e1_3 + d1_1_1 then e1_3 + d1_1_1 else e1_3 in
let d1_3_2 = if e2_3 > d1_3_1 + d1_1_2 then d1_3_1 + d1_1_2 else e2_3 in
let d1_3_3 = if int(5, 0) > d1_3_1 + d1_1_3 then d1_3_1 + d1_1_3 else int(5, 0) in
let d2_1_1 = if d1_1_1 > d1_1_2 + d1_2_1 then d1_1_2 + d1_2_1 else d1_1_1 in
let d2_1_2 = if d1_1_2 > d1_1_2 + d1_2_2 then d1_1_2 + d1_2_2 else d1_1_2 in
let d2_1_3 = if d1_1_3 > d2_1_2 + d1_2_3 then d2_1_2 + d1_2_3 else d1_1_3 in
let d2_2_1 = if d1_2_1 > d1_2_2 + d1_2_1 then d1_2_2 + d1_2_1 else d1_2_1 in
let d2_2_2 = if d1_2_2 > d1_2_2 + d1_2_2 then d1_2_2 + d1_2_2 else d1_2_2 in
let d2_2_3 = if d1_2_3 > d2_2_2 + d1_2_3 then d2_2_2 + d1_2_3 else d1_2_3 in
let d2_3_1 = if d1_3_1 > d1_3_2 + d2_2_1 then d1_3_2 + d2_2_1 else d1_3_1 in
let d2_3_2 = if d1_3_2 > d1_3_2 + d2_2_2 then d1_3_2 + d2_2_2 else d1_3_2 in
let d2_3_3 = if d1_3_3 > d2_3_2 + d2_2_3 then d2_3_2 + d2_2_3 else d1_3_3 in
let d3_1_1 = if d2_1_1 > d2_1_3 + d2_3_1 then d2_1_3 + d2_3_1 else d2_1_1 in
let d3_1_2 = if d2_1_2 > d2_1_3 + d2_3_2 then d2_1_3 + d2_3_2 else d2_1_2 in
let d3_1_3 = if d2_1_3 > d2_1_3 + d2_3_3 then d2_1_3 + d2_3_3 else d2_1_3 in
let d3_2_1 = if d2_2_1 > d2_2_3 + d2_3_1 then d2_2_3 + d2_3_1 else d2_2_1 in
let d3_2_2 = if d2_2_2 > d2_2_3 + d2_3_2 then d2_2_3 + d2_3_2 else d2_2_2 in
let d3_2_3 = if d2_2_3 > d2_2_3 + d2_3_3 then d2_2_3 + d2_3_3 else d2_2_3 in
let d3_3_1 = if d2_3_1 > d2_3_3 + d2_3_1 then d2_3_3 + d2_3_1 else d2_3_1 in
let d3_3_2 = if d2_3_2 > d2_3_3 + d2_3_2 then d2_3_3 + d2_3_2 else d2_3_2 in
let d3_3_3 = if d2_3_3 > d2_3_3 + d2_3_3 then d2_3_3 + d2_3_3 else d2_3_3 in
d3_1_3
