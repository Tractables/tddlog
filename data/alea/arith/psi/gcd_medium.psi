// gcd_medium: experiments/psi/gcd_medium.psi of Tractables/Alea.jl, branch arithmetic,
// commit 7e9ff23517086eb4518845e50218bf18b4d9f2a5 (Apache License 2.0), the
// Psi program of Cao et al. (UAI 2023); this header added.
def main(){
    a := uniformInt(1, 1024);
    b := uniformInt(1, 1024);
repeat 16 
    {
        converged := (b == 0);
        amb := (a % b);
        if converged {
            a = a;
            b = b;
        }
        else {
            a = b;
            b = amb;
        }
    }
    answer := (a == 1);
    return answer;
}
