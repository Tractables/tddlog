fun draw (have: (bool, (bool, (bool, (bool, (bool, (bool, (bool, bool))))))) ) {
    let draw1 = uniform(3, 0, 8) in
    let draw2 = uniform(3, 0, 8) in

    let t = observe(draw1 != draw2) in

    let r0 = (fst have) || (draw1 == int(3, 0)) || (draw2 == int(3, 0)) in
    let r1 = (fst (snd have)) || (draw1 == int(3, 1)) || (draw2 == int(3, 1)) in
    let r2 = (fst (snd (snd have))) || (draw1 == int(3, 2)) || (draw2 == int(3, 2)) in
    let r3 = (fst (snd (snd (snd have)))) || (draw1 == int(3, 3)) || (draw2 == int(3, 3)) in
    let r4 = (fst (snd (snd (snd (snd have))))) || (draw1 == int(3, 4)) || (draw2 == int(3, 4)) in
    let r5 = (fst (snd (snd (snd (snd (snd have)))))) || (draw1 == int(3, 5)) || (draw2 == int(3, 5)) in
    let r6 = (fst (snd (snd (snd (snd (snd (snd have))))))) || (draw1 == int(3, 6)) || (draw2 == int(3, 6)) in
    let r7 = (snd (snd (snd (snd (snd (snd (snd have))))))) || (draw1 == int(3, 7)) || (draw2 == int(3, 7)) in
    (r0, (r1, (r2, (r3, (r4, (r5, (r6, r7)))))))
}

let h0 = (false, (false, (false, (false, (false, (false, (false, false))))))) in
let h1 = draw(h0) in
let h2 = draw(h1) in
let h3 = draw(h2) in
let h4 = draw(h3) in
let h5 = draw(h4) in
let h6 = draw(h5) in
let h7 = draw(h6) in
let h = draw(h7) in
(fst h) && 
(fst (snd h)) && 
(fst (snd (snd h))) && 
(fst (snd (snd (snd h)))) && 
(fst (snd (snd (snd (snd h))))) &&
(fst (snd (snd (snd (snd (snd h)))))) &&
(fst (snd (snd (snd (snd (snd (snd h))))))) &&
(snd (snd (snd (snd (snd (snd (snd h)))))))