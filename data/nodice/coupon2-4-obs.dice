fun draw (have: (bool, (bool, (bool, bool))) ) {
    let draw1 = uniform(2, 0, 4) in
    let draw2 = uniform(2, 0, 4) in

    let t = observe(draw1 != draw2) in

    let r0 = (fst have) || (draw1 == int(2, 0)) || (draw2 == int(2, 0)) in
    let r1 = (fst (snd have)) || (draw1 == int(2, 1)) || (draw2 == int(2, 1)) in
    let r2 = (fst (snd (snd have))) || (draw1 == int(2, 2)) || (draw2 == int(2, 2)) in
    let r3 = (snd (snd (snd have))) || (draw1 == int(2, 3)) || (draw2 == int(2, 3)) in
    (r0, (r1, (r2, r3)))
}

let h0 = (false, (false, (false, false))) in
let h1 = draw(h0) in
let h2 = draw(h1) in
let h3 = draw(h2) in
let h = draw(h3) in
(fst h) && (fst (snd h)) && (fst (snd (snd h)))  && (snd (snd (snd h)))